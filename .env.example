# Hugging Face token — required for speaker diarization.
# Get one at https://huggingface.co/settings/tokens, then accept terms on:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# Whisper model size: tiny | base | small | medium | large-v3
# Larger = better accuracy, slower, more RAM. Default: small.
# WHISPER_MODEL=small

# Default browser for Instagram cookies (overrideable in the UI).
# Required for private/login-gated reels. The browser must be installed
# and logged into instagram.com.
# IG_COOKIES_BROWSER=chrome   # or firefox, safari, edge, brave, opera

# Alternative: a Netscape-format cookies.txt file.
# IG_COOKIES_FILE=/path/to/cookies.txt
